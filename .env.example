# ── Frontend (Vite) ──────────────────────────────────────────────────────────
# Leave empty in local dev so the Vite proxy (:5173 → :5087) is used.
# Production / preview against a remote API:
# VITE_API_BASE_URL=https://your-api-host

# SAP mock fallback (frontend only).
# DEV: default ON unless set to false. PROD build: default OFF unless true.
# VITE_ALLOW_SAP_MOCK=true
# VITE_ALLOW_SAP_MOCK=false

# ── Backend — JWT / database (API host env or appsettings) ───────────────────
# ConnectionStrings__DefaultConnection=Server=.;Database=StockWarehouseDb;Integrated Security=True;TrustServerCertificate=True;Encrypt=False;
# Jwt__Key=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
# Jwt__Issuer=StockWarehouseAPI
# Jwt__Audience=StockWarehouseClient
# Jwt__ExpiresInMinutes=480

# ── Backend — SAP ────────────────────────────────────────────────────────────
# SapClient__Provider=Http
# SapClient__UseMock=false
# SapHttp__BaseUrl=http://127.0.0.1:8000
# SapHttp__Username=
# SapHttp__Password=
# SapHttp__Client=001
# SapHttp__Language=TR
# SapHttp__TimeoutSeconds=30

# ── Backend — SMTP ───────────────────────────────────────────────────────────
# Integrations__Smtp__Enabled=true
# Integrations__Smtp__Host=smtp.firma.com
# Integrations__Smtp__Port=587
# Integrations__Smtp__UseSsl=true
# Integrations__Smtp__UserName=
# Integrations__Smtp__Password=
# Integrations__Smtp__FromEmail=noreply@firma.com
# Integrations__Smtp__FromName=StockGuard
#
# Local smoke (Mailhog / Papercut):
# Integrations__Smtp__Enabled=true
# Integrations__Smtp__Host=localhost
# Integrations__Smtp__Port=1025
# Integrations__Smtp__UseSsl=false
#
# API: GET/PUT /api/notifications/smtp · POST /api/notifications/smtp/test
# Reports: POST /api/reports/email { provider?: "Smtp"|"SendGrid"|null }

# ── Backend — SendGrid ───────────────────────────────────────────────────────
# Integrations__SendGrid__ApiKey=
# Integrations__SendGrid__FromEmail=noreply@stockwarehouse.local
# Integrations__SendGrid__AlertEmail=ops@firma.com

# ── Backend — Slack / Teams webhooks ─────────────────────────────────────────
# Integrations__Slack__Enabled=true
# Integrations__Slack__WebhookUrl=https://hooks.slack.com/services/...
# Integrations__Teams__Enabled=true
# Integrations__Teams__WebhookUrl=https://outlook.office.com/webhook/...
#
# API: GET/PUT /api/notifications/slack|teams · POST …/test
# Critical stock: POST /api/alerts/low-stock/notify

# ── OpenAPI type generation (optional) ───────────────────────────────────────
# OPENAPI_URL=http://localhost:5087/swagger/v1/swagger.json
# OPENAPI_FILE=./openapi/swagger.json

# ── Faz 6 — Entra ID SSO (optional; password login always works) ─────────────
# SPA public client — no client secret. Leave empty to hide the Microsoft button.
# VITE_ENTRA_CLIENT_ID=
# VITE_ENTRA_TENANT_ID=
# VITE_ENTRA_REDIRECT_URI=http://localhost:5173/auth/callback
#
# Backend (must match the same app registration):
# Authentication__Entra__Enabled=true
# Authentication__Entra__TenantId=
# Authentication__Entra__ClientId=
# Authentication__Entra__RedirectUri=http://localhost:5173/auth/callback
# Authentication__Entra__DefaultRole=Manager
# Authentication__Entra__AutoProvisionUsers=true
# Authentication__Entra__PreferEntraRoles=true
#
# Flow: MSAL redirect → id_token → POST /api/auth/entra/login → StockGuard JWT (localStorage).
# Role mapping: Entra app roles / "roles" claim → SuperAdmin|Admin|WarehouseManager|Manager.
# GET /api/auth/entra/config — public status when Enabled=false.